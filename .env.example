# Set to true after uploading photos to public/images/ (see public/images/README.md)
NEXT_PUBLIC_USE_LOCAL_PHOTOS=false

# REQUIRED IN PRODUCTION: the canonical origin of the deployed site.
# Every canonical URL, hreflang alternate, sitemap entry, OG url and
# JSON-LD @id is built from this value. Must match the primary domain
# configured in Vercel exactly (no trailing slash, and pick either the
# apex or the www host — whichever one you set as primary).
NEXT_PUBLIC_SITE_URL=https://thrivewithsharuja.com
